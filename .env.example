# Configuración local usada por scripts/start_interface.ps1 (Windows) y start_interface.sh (Linux).
RUTA_DIA_RUNTIME=langgraph
RUTA_DIA_MODEL=Qwen3.5-4B-Q4_K_M
RUTA_DIA_BASE_URL=http://127.0.0.1:18083/v1
# Elige una clave privada propia; se usa entre el backend y llama.cpp en tu equipo.
RUTA_DIA_API_KEY=reemplaza-esto-con-una-clave-local-privada

# Memoria local durable. Por defecto: %LOCALAPPDATA%\RutaDIA
# RUTA_DIA_DATA_DIR=C:\ruta\privada\RutaDIA

# Para usar Gemini en lugar de Qwen, cambia RUTA_DIA_MODEL, quita
# RUTA_DIA_BASE_URL y RUTA_DIA_API_KEY, y configura una clave de Gemini.
# GEMINI_API_KEY=

# Mantener apagado en ejecucion normal; habilitar solo para diagnostico.
RUTA_DIA_VERBOSE=false

# RUTA_DIA_TEMPERATURE=0.7
# RUTA_DIA_MAX_TOKENS=384
# RUTA_DIA_TIMEOUT=240
# RUTA_DIA_SEED=42

# Calendarios de Google y Outlook (opcional). Sin estas variables, Ajustes los muestra como
# «No disponible en este servidor». Pasos para obtenerlas: docs/calendarios-externos.md
# HILO_GOOGLE_CLIENT_ID=
# HILO_GOOGLE_CLIENT_SECRET=
# HILO_MICROSOFT_CLIENT_ID=
# HILO_MICROSOFT_CLIENT_SECRET=
# HILO_MICROSOFT_TENANT=common
# Dirección pública de Hilo, tal como se registró en Google y Microsoft (sin / al final).
# HILO_URL_PUBLICA=https://hilo.ejemplo.com
# Clave para cifrar los permisos guardados. Sin ella se crea calendarios.key en la carpeta de datos.
# HILO_CLAVE_CALENDARIOS=
