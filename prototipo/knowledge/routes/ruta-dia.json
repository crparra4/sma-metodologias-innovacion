{
  "id": "ruta-dia",
  "name": "Ruta DIA",
  "version": "0.1.0",
  "stages": [
    {
      "id": 1,
      "phase": "Descubrimiento",
      "name": "Definir un reto",
      "objective": "Delimitar la problemática u oportunidad sin anticipar soluciones.",
      "tools": ["arbol-problemas", "cinco-porques", "pestel"]
    },
    {
      "id": 2,
      "phase": "Descubrimiento",
      "name": "Entendimiento del reto",
      "objective": "Profundizar la comprensión inicial y preparar el trabajo de empatía.",
      "tools": []
    },
    {
      "id": 3,
      "phase": "Descubrimiento",
      "name": "Profundización y empatía",
      "objective": "Comprender al usuario, su experiencia y las hipótesis aún no validadas.",
      "tools": [
        "customer-journey",
        "trabajo-de-campo",
        "mapa-empatia",
        "canvas-propuesta-valor",
        "arquetipo-usuario"
      ]
    },
    {
      "id": 4,
      "phase": "Descubrimiento",
      "name": "Ideación",
      "objective": "Generar y priorizar alternativas de solución.",
      "tools": ["scamper", "sit", "seis-sombreros", "moscow", "matriz-priorizacion"]
    },
    {
      "id": 5,
      "phase": "Descubrimiento",
      "name": "Alistamiento del experimento",
      "objective": "Formular hipótesis y criterios observables de validación.",
      "tools": ["ficha-hipotesis"]
    },
    {
      "id": 6,
      "phase": "Incubación",
      "name": "Plan de experimentación",
      "objective": "Diseñar cómo se ejecutará y medirá el experimento.",
      "tools": ["lean-canvas"]
    },
    {
      "id": 7,
      "phase": "Incubación",
      "name": "Ejecución del experimento",
      "objective": "Construir y ejecutar el experimento definido.",
      "tools": []
    },
    {
      "id": 8,
      "phase": "Incubación",
      "name": "Medición y análisis",
      "objective": "Analizar la experiencia, los indicadores y el aprendizaje obtenido.",
      "tools": []
    },
    {
      "id": 9,
      "phase": "Aceleración",
      "name": "Factibilidad y transferencia",
      "objective": "Evaluar factibilidad y preparar la transferencia de la solución.",
      "tools": []
    },
    {
      "id": 10,
      "phase": "Aceleración",
      "name": "Validación para escalamiento",
      "objective": "Validar las condiciones necesarias para escalar la solución.",
      "tools": []
    }
  ],
  "tools": [
    {
